<section id="packages">
    <div id="top-content">
        <!-- <img src="img/packages/green rainbow.svg" alt="part of a green outline"> -->
        <h1 class="section-title">Po<span><img src="img/packages/green rainbow.svg" alt="green design">pu</span>lar Packages</h1>

        <div id="package-button-container">
            <button id="left-arrow"><img src="img/packages/arrow-left.svg" alt="arrow left button"></button>
            <button id="right-arrow"><img src="img/packages/arrow-right.svg" alt="arrow right button"></button>   
        </div>
    </div>


    <ul id="package-card-container">
        <li class="package-card" id="card-1">
            <!-- <img src="img/packages/card1.jpg" alt="hero images" class="img-scaler"> -->
             <div class="package-card-img"></div>
            <p>The basic package to start your promotion</p>

            <div class="package-status-bar">
                <ul class="user-icons">
                    <li class="icon-1"></li>
                    <li class="icon-3"></li>
                    <li class="icon-2"></li>
                </ul>
    
                <h4>200k+ users</h4>
                <h3>$89.00</h3>
            </div>
           
        
        </li>

        <li class="selected package-card" id="card-2">
            <!-- <img src="img/packages/card3.jpg" alt="hero images" class="img-scaler"> -->
            <div class="package-card-img"></div>
            <p>The standard package to grow your business</p>
            
            <div class="package-status-bar">
                <ul class="user-icons">
                    <li class="icon-1"></li>
                    <li class="icon-3"></li>
                    <li class="icon-2"></li>
                </ul>
                <h4>140k+ users</h4>
                <h3>$109.00</h3>
            </div>

        </li>

        <li class= "package-card" id="card-3">
            <!-- <img src="img/packages/card2.jpg" alt="hero images" class="img-scaler"> -->
            <div class="package-card-img"></div>
            <p>The premium package to boost your promotion</p>

           <div class="package-status-bar">
                <ul class="user-icons">
                    <li class="icon-1"></li>
                    <li class="icon-3"></li>
                    <li class="icon-2"></li>
                </ul>

                <h4>99k+ users</h4>
                <h3>$149.00</h3>
           </div> 
        </li>

    </ul>
</section>