<section id="packages">
    <img src="img/packages/green rainbow.svg" alt="part of a green outline">
    <h1 class="section-title">Popular Packages</h1>

    <div id="package-button-container">
        <button id="left-arrow"><img src="img/packages/arrow-left.svg" alt="arrow left button"></button>
        <button id="right-arrow"><img src="img/packages/arrow-right.svg" alt="arrow right button"></button>   
    </div>


    <ul id="package-card-container">
        <li class="package-card">
            <img src="img/packages/card1.jpg" alt="hero images" class="img-scaler">
            <p>The basic package to start your promotion</p>
           
            
            <ul>
                <li><img src="img/packages/user1.jpg" alt=" user images"></li>
                <li><img src="img/packages/user2.jpg" alt=" user images"></li>
                <li><img src="img/packages/user3.jpg" alt=" user images"></li>
            </ul>

            <h4>200k+ users</h4>
            <h3>$89.00</h3>
        </li>

        <li class="selected package-card">
            <img src="img/packages/card3.jpg" alt="hero images" class="img-scaler">
            <p>The standard package to grow your business</p>
           
            <ul>
                <li>
                    <li><img src="img/packages/user1.jpg" alt=" user images"></li>
                    <li><img src="img/packages/user3.jpg" alt=" user images"></li>
                    <li><img src="img/packages/user2.jpg" alt=" user images"></li>
                </li>
            </ul>

            <h4>140k+ users</h4>
            <h3>$109.00</h3>

        </li>

        <li class= "package-card">
            <img src="img/packages/card2.jpg" alt="hero images" class="img-scaler">
            <p>The premium package to boost your promotion</p>

            
            <ul>
                <li>
                    <li><img src="img/packages/user5.jpg" alt=" user images"></li>
                    <li><img src="img/packages/user3.jpg" alt=" user images"></li>
                    <li><img src="img/packages/user4.jpg" alt=" user images"></li>
                </li>
            </ul>

            <h4>99k+ users</h4>
            <h3>$149.00</h3>
        </li>

    </ul>
</section>